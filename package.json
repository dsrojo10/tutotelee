{
  "name": "tutotelee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/core.test.js tests/pairing.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-tutotelee \"vitest run tests/rules/database.rules.test.js\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
